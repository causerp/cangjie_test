// Verify a rejected guard is diagnosed at the guard rather than the complete case head.
// EXEC-PIPE-0: %compiler %cmp_opt %diag_json %f -o %output 2>&1 | compare %f
// EXEC-PIPE-0: %compiler %cmp_opt %diag_json -O2 %f -o %output 2>&1 | compare %f

// ASSERT: scan-1 "DiagKind": "chir_unreachable_pattern"

main(args: Array<String>) {
    match (args.size) {
        case 2 | 3 where false => 0
        case _ => 1
    }
}
