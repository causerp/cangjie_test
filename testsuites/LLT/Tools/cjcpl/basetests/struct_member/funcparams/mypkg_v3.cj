package myPkgA

// V3
public open class Base {}
public open class Sub <: Base {}

// 场景三：将函数f1的x参数改为命名参数x!: Int64，为API+ABI均不兼容，因为下游包的使用处对x的传参无法编译通过
public struct Foo {
    public func f1(x!: Int64, z!: Int64, y!: Int64 = 3, k!: Sub): Int64 {
        return 1
    }
}
