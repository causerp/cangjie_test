// LEVEL: 3
// EXEC: %compiler %cmp_opt %optimization_level_2 --no-sub-pkg %f -o %output
// RUN-EXEC: %export cjHeapSize=512mb && %run %run_opt %output %run_args 2>&1 | compare %f
// ASSERT: scan ms

import std.time.*
import std.collection.*
import std.math.*

func pathTo(node: GridNode): ArrayList<GridNode> {
    var curr = node
    var path: ArrayList<GridNode> = ArrayList<GridNode>()
    while (curr.parent.isSome()) {
        path.add(curr, at: 0)
        curr = curr.parent.getOrThrow()
    }
    return path
}
func getHeap(): BinaryHeap {
    return BinaryHeap({
        node: GridNode => return node.f
    })
}

class Options {
    var closest: ?Bool = Option<Bool>.None
    var heuristic: ?((GridNode, GridNode) -> Int64) = Option<((GridNode, GridNode) -> Int64)>.None
    var diagonal: ?Bool = Option<Bool>.None
}

class Astar {
   
    func search(graph: Graph, start: GridNode, end: GridNode, options!: Options = Options()): ArrayList<GridNode> {
        graph.cleanDirty()

        

        let heuristic = options.heuristic ?? Heuristics.manhattan
        let closest = options.closest ?? false
        let openHeap = getHeap()
        var closestNode = start // set the start node to be the closest if required

        start.h = heuristic(start, end)
        graph.markDirty(start)

        openHeap.push(start)

        while (openHeap.size() > 0) {
 
            let currentNode = openHeap.pop()

            // End case -- result has been found, return the traced path.
            if (refEq(currentNode, end)) {
                return pathTo(currentNode)
            }

            // Normal case -- move currentNode from open to closed, process each of its neighbors.
            currentNode.closed = true

            // Find all neighbors for the current node.
            let neighbors = graph.neighbors(currentNode)

            for (neighbor in neighbors) {
                if (neighbor.closed || neighbor.isWall()) {
                    // Not a valid node to process, skip to next neighbor.
                    continue
                }

                // The g score is the shortest distance from start to current node.
                // We need to check if the path we have arrived at this neighbor is the shortest one we have seen yet.
                let gScore = currentNode.g + neighbor.getCost(currentNode)
                let beenVisited = neighbor.visited

                if (!beenVisited || gScore < neighbor.g) {

                    // Found an optimal (so far) path to this node.  Take score for node to see how good it is.
                    neighbor.visited = true
                    neighbor.parent = currentNode

                    

                    if (neighbor.h != 0) {
                        neighbor.h = neighbor.h
                    } else {
                        neighbor.h = heuristic(neighbor, end)
                    }

                    neighbor.g = gScore
                    neighbor.f = neighbor.g + neighbor.h
                    graph.markDirty(neighbor)
                    if (closest) {
                   
                        if (neighbor.h < closestNode.h || (neighbor.h == closestNode.h && neighbor.g < closestNode.g)) {
                            closestNode = neighbor
                        }
                    }

                    if (!beenVisited) {
                      
                        openHeap.push(neighbor)
                    } else {
                     
                        openHeap.rescoreElement(neighbor)
                    }
                }
            }
        }
        if (closest) {
            return pathTo(closestNode)
        }

        // No result was found - empty ArrayList signifies failure to find path.
        return ArrayList<GridNode>([])
    }

    func cleanNode(node: GridNode) {
        node.f = 0
        node.g = 0
        node.h = 0
        node.visited = false
        node.closed = false
        node.parent = Option<GridNode>.None
    }
}

let astar = Astar()


class Heuristics {
    static func manhattan(pos0: GridNode, pos1: GridNode): Int64 {
        let d1 = abs(pos1.x - pos0.x)
        let d2 = abs(pos1.y - pos0.y)
        return d1 + d2
    }

    static func diagonal(pos0: GridNode, pos1: GridNode): Int64 {
        let D = 1
        let D2 = Int64(sqrt(2.0))
        let d1 = abs(pos1.x - pos0.x)
        let d2 = abs(pos1.y - pos0.y)
        return (D * (d1 + d2)) + ((D2 - (2 * D)) * min(d1, d2))
    }
}
/**
     * A graph memory structure
     * @param {ArrayList} gridIn 2D ArrayList of input weights
     * @param {Object} [options]
     * @param {bool} [options.diagonal] Specifies whether diagonal moves are allowed
     */
class Graph {
    var dirtyNodes: ArrayList<GridNode>

    var nodes: ArrayList<GridNode>
    var grid: ArrayList<ArrayList<GridNode>>

    var diagonal = false

    init(gridIn: ArrayList<ArrayList<Int>>, options!: ?Options = Option<Options>.None) {
        let opt = options ?? Options()
        dirtyNodes = ArrayList<GridNode>()
        nodes = ArrayList<GridNode>()
        diagonal = !(!(opt.diagonal ?? false))
        grid = ArrayList<ArrayList<GridNode>>()

        for (x in 0..gridIn.size) {
            grid.add(ArrayList<GridNode>([]))
            for (y in 0..gridIn[x].size) {
                let node = GridNode(x, y, Float64(gridIn[x][y]))
                grid[x].add(node)
                nodes.add(node)
            }
        }
        INIT()
    }
    func INIT() {
        dirtyNodes = ArrayList<GridNode>()
        for (node in nodes) {
            astar.cleanNode(node)
        }
    }
    func cleanDirty() {
        for (node in dirtyNodes) {
            astar.cleanNode(node)
        }
        dirtyNodes = ArrayList<GridNode>()
    }
    func markDirty(node: GridNode) {
        dirtyNodes.add(node)
    }
    func neighbors(node: GridNode): ArrayList<GridNode> {
        var ret: ArrayList<GridNode> = ArrayList<GridNode>()
        let x = node.x
        let y = node.y
        let grid = grid

        // West
        if (arrContain(grid, x - 1, y)) {
            ret.add(grid[x - 1][y])
        }

        // East
        if (arrContain(grid, x + 1, y)) {
            ret.add(grid[x + 1][y])
        }

        // South
        if (arrContain(grid, x, y - 1)) {
            ret.add(grid[x][y - 1])
        }

        // North
        if (arrContain(grid, x, y + 1)) {
            ret.add(grid[x][y + 1])
        }

        if (diagonal) {
            // Southwest
            if (arrContain(grid, x - 1, y - 1)) {
                ret.add(grid[x - 1][y - 1])
            }

            // Southeast
            if (arrContain(grid, x + 1, y - 1)) {
                ret.add(grid[x + 1][y - 1])
            }

            // Northwest
            if (arrContain(grid, x - 1, y + 1)) {
                ret.add(grid[x - 1][y + 1])
            }

            // Northeast
            if (arrContain(grid, x + 1, y + 1)) {
                ret.add(grid[x + 1][y + 1])
            }
        }
        return ret
    }

    func toString(): String {
        var graphString: ArrayList<String> = ArrayList<String>()
        let nodes = grid
        for (xNode in nodes) {
            var rowDebug: ArrayList<String> = ArrayList<String>()
            for (yNode in xNode) {
                rowDebug.add("${yNode.weight}")
            }
            graphString.add(String.join(rowDebug.toArray(), delimiter: " "))
        }
        return String.join(graphString.toArray(), delimiter: "\n")
    }
}

class GridNode {
    var x: Int64
    var y: Int64
    var weight: Float64

    var f: Int64
    var g: Int64
    var h: Int64
    var visited: Bool
    var closed: Bool
    var parent: ?GridNode

    init(x: Int64, y: Int64, weight: Float64) {
        this.x = x
        this.y = y
        this.weight = weight
        this.f = 0
        this.g = 0
        this.h = 0
        this.visited = false
        this.closed = false
        this.parent = Option<GridNode>.None
    }

    func toString(): String {
        return "[${this.x} ${this.y}]"
    }

    func getCost(fromNeighbor: ?GridNode): Int64 {
        // Take diagonal weight into consideration.
        if (fromNeighbor.isSome() && fromNeighbor.getOrThrow().x != this.x && fromNeighbor.getOrThrow().y != this.y) {
            return Int64(this.weight * 1.41421)
        }
        return Int64(this.weight)
    }
    func isWall(): Bool {
        return this.weight == 0.0
    }
}

type ScoreFunction = (node: GridNode) -> Int

class BinaryHeap {
    var content: ArrayList<GridNode> = ArrayList<GridNode>()
    var scoreFunction: ScoreFunction
    init(scoreFunction: ScoreFunction) {
        this.content = ArrayList<GridNode>()
        this.scoreFunction = scoreFunction
    }

    func push(element: GridNode) {
        // Add the new element to the end of the ArrayList.
        content.add(element)

        // Allow it to sink down.
        sinkDown(content.size - 1)
    }
    func pop(): GridNode {
        // Store the first element so we can return it later.
        let result = this.content[0]
        // Get the element at the end of the ArrayList.
        let end = this.content.remove(at: content.size - 1)
        // If there are any elements left, put the end element at the
        // start, and let it bubble up.
        if (this.content.size > 0) {
            this.content[0] = end
            bubbleUp(0)
        }
        return result
    }

    func size(): Int64 {
        return content.size
    }
    func rescoreElement(node: GridNode) {
        var firstindex = 0
        for (nd in this.content) {
            if (nd.x == node.x && nd.y == node.y) {
                break
            }
            firstindex += 1
        }
        sinkDown(firstindex)
    }

    func sinkDown(n: Int64) {
        var _n = n
        // Fetch the element that has to be sunk.
        let element = content[_n]
        // When at 0, an element can not sink any further.
        while (_n > 0) {
            // Compute the parent element's index, and fetch it.
            let parentN = ((_n + 1) >> 1) - 1
            let parent = content[parentN]
            // Swap the elements if the parent is greater.
            if (scoreFunction(element) < scoreFunction(parent)) {
                content[parentN] = element
                content[_n] = parent
                // Update 'n' to continue at the new position.
                _n = parentN
            }
                // Found a parent that is less, no need to sink any further.
                else {
                break;
            }
        }
    }
    func bubbleUp(n: Int64) {
        var _n = n
        // Look up the target element and its score.
        let length = content.size
        let element = content[_n]
        let elemScore = scoreFunction(element)
        while (true) {
            // Compute the indices of the child elements.
            let child2N = (_n + 1) << 1
            let child1N = child2N - 1
            // This is used to store the new position of the element, if any.
            var swap: ?Int64 = Option<Int64>.None
            var child1Score: ?Int64 = Option<Int64>.None

            // If the first child exists (is inside the array)...
            if (child1N < length) {
                // Look it up and compute its score.
                let child1 = content[child1N]
                child1Score = scoreFunction(child1)

                // If the score is less than our element's, we need to swap.
                if (child1Score.getOrThrow() < elemScore) {
                    swap = child1N
                }
            }

            // Do the same checks for the other child.
            if (child2N < length) {
                let child2 = content[child2N]
                let child2Score = scoreFunction(child2)

                if (swap.isNone()) {
                    if (child2Score < elemScore) {
                        swap = child2N
                    }
                } else {
                    if (child2Score < child1Score.getOrThrow()) {
                        swap = child2N
                    }
                }

                
            }

            // If the element needs to be moved, swap it, and continue.
            if (swap.isSome()) {
                content[_n] = content[swap.getOrThrow()]
                content[swap.getOrThrow()] = element
                _n = swap.getOrThrow()
            }
                // Otherwise, we are done.
                else {
                break
            }
        }
    }
}

let isDebug: Bool = false
func DeBugLog(msg: Any, file: String, line: Int64, fn: String) {
    if (isDebug) {
        let prefix = "${(msg as String).getOrThrow()}"
        println(prefix)
    }
}

