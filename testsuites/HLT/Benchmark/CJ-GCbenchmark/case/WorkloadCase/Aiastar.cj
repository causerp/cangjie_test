    /// @Aiastar
    func runIteration() {
        let startTime = Timer().getTime()
        for (_ in 0..20) {
            let start = graph.grid[0][0]
            let end = graph.grid[123][321]
            let result = astar.search(graph, start, end)
        }
        let endTime = Timer().getTime()
        println("Aiastar: ms = " + "${Float64((endTime-startTime).toNanoseconds())/1000000.0}")
    }
}

class Timer {
    // ms
    public func getTime() {
        let time = DateTime.now()
        return time
    }
}


func arrContain(arr: ArrayList<ArrayList<GridNode>>, x: Int64, y: Int64): Bool {
    return (arr.size > x && x >= 0) && (arr[x].size > y && y >= 0)
}

main() {
    Aiastar().runIteration()
}
