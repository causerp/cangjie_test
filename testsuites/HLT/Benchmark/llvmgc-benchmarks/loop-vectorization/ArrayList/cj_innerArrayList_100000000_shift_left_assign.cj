import std.collection.*

func test0() : Int32 {
  var a: ArrayList<Int32> = ArrayList<Int32>(100000000) {i => Int32(2 * i)}

  var outterLoopCnt = 10
  var sum : ArrayList<Int32> = ArrayList<Int32>(outterLoopCnt) {i => Int32(0)};
  while (outterLoopCnt > 0) {
    outterLoopCnt--
    for (i in 0.. a.size) {
      a[i] <<= 3
    }

    for (i in 0.. a.size) {
      sum[Int64(outterLoopCnt)] += a[i] / 5 + Int32(outterLoopCnt)
    }
    println(sum[Int64(outterLoopCnt)])
  }
  println("====")
  if ( (sum[9] != 1981884160)
    || (sum[8] != 325879912)
    || (sum[7] != 1203863822)
    || (sum[6] != -1379976692)
    || (sum[5] != -1595476537)
    || (sum[4] != 816082179)
    || (sum[3] != -666309150)
    || (sum[2] != 200468750)
    || (sum[1] != 103750000)
    || (sum[0] != 30000000)) {
      return 1
    }
  return 0
}

main() {
  var result0 = test0()
  if (result0 != 0) {
    return 1
  }
  return 0
}