import std.collection.*

func test0() : Int64 {
  var a: Array<Int64> = Array<Int64>(100000000) {i => Int64(2 * i)}

  var outterLoopCnt = 10
  var sum : Array<Int64> = Array<Int64>(outterLoopCnt) {i => Int64(0)};
  while (outterLoopCnt > 0) {
    outterLoopCnt--
    for (i in 0.. a.size) {
      a[i] /= 3
    }

    for (i in 0.. a.size) {
      sum[Int64(outterLoopCnt)] += a[i] / 5 + Int64(outterLoopCnt)
    }
    println(sum[Int64(outterLoopCnt)])
  }
  println("====")
  if ( (sum[9] != 666667513333334)
    || (sum[8] != 222222971111114)
    || (sum[7] != 74074723703712)
    || (sum[6] != 24691907901248)
    || (sum[5] != 8230902633760)
    || (sum[4] != 2743834211445)
    || (sum[3] != 914744737340)
    || (sum[2] != 304981580936)
    || (sum[1] != 101660530432)
    || (sum[0] != 33820193213)) {
      return 1
  }
  return 0
}

main() {
  var result0 = test0()
  if (result0 != 0) {
    return 1
  }
  return 0
}