import std.collection.*

func test0() : Int64 {
  var a: Array<Int64> = Array<Int64>(100000000) {i => Int64(2 * i)}
  var b: Array<Int64> = Array<Int64>(100000000) {i => Int64(3 * i)}
  var outterLoopCnt = 10
  var sum : Array<Int64> = Array<Int64>(outterLoopCnt) {i => Int64(0)};
  while (outterLoopCnt > 0) {
    outterLoopCnt--
    for (i in 0.. a.size) {
      a[i] = b[i] / 2
    }
    
    for (i in 0.. a.size) {
      sum[Int64(outterLoopCnt)] += a[i] / 5 + Int64(outterLoopCnt)
    }
    println(sum[Int64(outterLoopCnt)])
  }
  if ((sum[9] != 1500000840000000) || (sum[8] != 1500000740000000) || (sum[7] != 1500000640000000) || (sum[6] != 1500000540000000) || (sum[5] != 1500000440000000) || (sum[4] != 1500000340000000) || (sum[3] != 1500000240000000) || (sum[2] != 1500000140000000) || (sum[1] != 1500000040000000) || (sum[0] != 1499999940000000)) {
      return 1
  }
  return 0
}

main() {
  var result0 = test0()
  if (result0 != 0) {
    return 1
  }
  return 0
}
