func deepNested(x: Int64): Int64 {
    if (x > 0) {
        if (x > 1) {
            if (x > 2) {
                if (x > 3) {
                    if (x > 4) {
                        return 1
                    }
                }
            }
        }
    }
    return 0
}

main() {
    println(deepNested(10))
}
